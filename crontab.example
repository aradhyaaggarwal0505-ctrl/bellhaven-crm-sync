# Bellhaven -> CRM sync, every day at 06:00 local time. Proposals land in state/proposals.db;
# a reviewer approves them in the review app (python review_app/app.py).
# Replace /path/to/bellhaven-sync with the checkout location.
0 6 * * * cd /path/to/bellhaven-sync && .venv/bin/python run_pipeline.py --quiet >> logs/cron.log 2>&1
